{
  "name": "mxinspirex",
  "productName": "MxinspireX",
  "version": "0.2.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/ziguishian/MxInspireX.git"
  },
  "main": "dist/desktop/main.js",
  "private": true,
  "description": "Local-first enterprise AI design Agent for cultural-tourism and ship design",
  "type": "module",
  "scripts": {
    "setup:portable": "node scripts/run-portable.mjs --setup-only",
    "start:portable": "node scripts/run-portable.mjs",
    "verify:portable": "node scripts/run-portable.mjs --smoke",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:desktop\"",
    "dev:web": "concurrently -k \"npm:dev:renderer\" \"npm:api:dev\"",
    "dev:renderer": "vite --config apps/renderer/vite.config.ts",
    "dev:desktop": "wait-on http://localhost:5173 && npm run build:desktop && node scripts/launch-dev-macos.mjs",
    "build:desktop": "tsc -p apps/desktop/tsconfig.json --outDir dist/desktop && tsc -p apps/desktop/tsconfig.preload.json",
    "build": "vite build --config apps/renderer/vite.config.ts --mode desktop && npm run build:desktop",
    "build:web": "vite build --config apps/renderer/vite.config.ts",
    "build:site": "node scripts/build-public-site.mjs",
    "preview:web": "vite preview --config apps/renderer/vite.config.ts --host 127.0.0.1",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build:sidecar:lite": "node scripts/build-sidecar.mjs --profile=lite",
    "build:runtime-components": "node scripts/build-runtime-components.mjs",
    "package:mac": "npm run build && npm run build:sidecar && node scripts/package-macos.mjs",
    "package:all": "node scripts/package-distributions.mjs",
    "package:lite": "node scripts/package-lite-distributions.mjs",
    "package:win": "npm run build && node scripts/package-windows.mjs",
    "verify:agent-release": "node scripts/verify-agent-release.mjs",
    "test:task-recovery": "node scripts/test-task-recovery.cjs",
    "prepackage:win": "npm run verify:agent-release",
    "prepackage:mac": "npm run verify:agent-release",
    "prepackage:all": "npm run verify:agent-release",
    "prepackage:lite": "npm run verify:agent-release",
    "typecheck": "vue-tsc -p apps/renderer/tsconfig.json --noEmit && tsc -p apps/desktop/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cad-preview": "node scripts/test-cad-preview.cjs",
    "test:delivery-preview": "node scripts/test-delivery-preview.cjs",
    "test:delivery-findings": "node scripts/test-delivery-findings.cjs",
    "test:context-optimization": "node scripts/test-context-optimization.cjs",
    "test:asset-library": "node scripts/test-asset-library.cjs",
    "test:project-previews": "node scripts/test-project-previews.cjs",
    "test:canvas-export": "npm run build:desktop && node scripts/test-canvas-export.cjs",
    "test:image-download": "node scripts/test-image-download.cjs",
    "test:html-canvas": "node scripts/test-html-canvas.cjs",
    "test:html-generation": "node scripts/test-html-generation.cjs",
    "test:node-resize": "node scripts/test-node-resize.cjs",
    "test:node-composer": "node scripts/test-node-composer.cjs",
    "test:auto-layout-locks": "node scripts/test-auto-layout-locks.cjs",
    "test:message-editing": "npm run build && node scripts/test-message-editing.cjs",
    "test:node-markdown": "node scripts/test-node-markdown.cjs",
    "test:canvas-workspace": "node scripts/test-canvas-workspace.cjs",
    "test:canvas-edges": "node scripts/test-canvas-workspace.cjs --edges-only",
    "test:canvas-edge-persistence": "node scripts/test-canvas-edge-persistence.cjs",
    "test:canvas-snap": "node scripts/test-canvas-snap.cjs",
    "test:canvas-selection": "node scripts/test-canvas-selection.cjs",
    "test:interaction-upgrade": "node scripts/test-interaction-upgrade.cjs",
    "test:canvas-click-references": "node scripts/test-canvas-click-references.cjs",
    "test:canvas-overview": "node scripts/test-canvas-overview.cjs",
    "test:generation-feedback": "node scripts/test-generation-feedback.cjs",
    "test:xiaoju-sprite": "node scripts/test-xiaoju-sprite.cjs",
    "test:generation-frame": "node scripts/test-generation-frame.cjs",
    "test:first-request": "node scripts/test-first-request.cjs",
    "test:page-navigation": "node scripts/test-page-navigation.cjs",
    "test:reply-typing": "node scripts/test-reply-typing.cjs",
    "test:style-picker": "node scripts/test-style-picker.cjs",
    "test:clarification": "node scripts/test-clarification.cjs",
    "test:model-popover": "node scripts/test-model-popover.cjs",
    "api:dev": "node scripts/dev-api.mjs",
    "api:test": "uv run --project services/api pytest",
    "test:skills": "node scripts/test-skills.cjs",
    "test:svg-settings": "node scripts/test-svg-settings.cjs",
    "test:skill-mentions": "node scripts/test-skill-mentions.cjs",
    "test:drawing-canvas": "node scripts/test-drawing-canvas.cjs"
  },
  "dependencies": {
    "@openai/agents": "^0.17.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "electron-updater": "6.6.2",
    "extract-zip": "^2.0.1",
    "lucide-vue-next": "^0.468.0",
    "markdown-it": "^15.0.2",
    "three": "^0.177.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@electron/get": "^2.0.3",
    "@types/three": "^0.177.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^9.1.2",
    "electron": "^36.3.1",
    "electron-builder": "26.0.12",
    "resedit": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.2",
    "vue-tsc": "^3.3.11",
    "wait-on": "^8.0.3"
  }
}
